# Copie para .env. Nunca versione o arquivo .env real.
CONSTRUCTION_AI_HOST=127.0.0.1
CONSTRUCTION_AI_PORT=8787
VISUAL_DIAGNOSTICS=false
VISUAL_PROVIDER_TIMEOUT_MS=60000

# Primeiro adapter real recomendado.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Adapter alternativo OpenAI Responses API.
OPENAI_API_KEY=
OPENAI_VISUAL_MODEL=gpt-4.1-mini

# Adapter HTTP compatível com o contrato visual V1.
CUSTOM_VISUAL_ENDPOINT=
CUSTOM_VISUAL_API_KEY=
CUSTOM_VISUAL_MODEL=custom
# Somente para mock local de desenvolvimento; hosts remotos continuam exigindo HTTPS.
CUSTOM_VISUAL_ALLOW_HTTP_LOCALHOST=false

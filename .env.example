# Construction AI Studio V4 — runtime local
# Copie para .env somente se precisar alterar host/porta de desenvolvimento.
# A Imagem Inicial continua sendo analisada pelo fluxo ChatGPT + Relay.
# O Agente Fiscal Visual abaixo é isolado e opcional; ele atua somente em
# vídeos que já chegaram ao estado REVIEW_REQUIRED.

CONSTRUCTION_AI_HOST=127.0.0.1
CONSTRUCTION_AI_PORT=8787

# A análise da Imagem Inicial fica vinculada ao SHA-256 da imagem e entra
# no Construction AI como revisão estruturada antes da criação do projeto.
# A configuração abaixo pertence somente ao Agente Fiscal de vídeo.

# Agente Fiscal Visual autônomo — deixe todas vazias para manter o modo manual.
# Nunca versionar chaves reais. OpenAI é fallback pago e não é acionada
# automaticamente, salvo VISUAL_FISCAL_ALLOW_PAID_FALLBACK=true.
VISUAL_FISCAL_AUTOMATION_ENABLED=true
VISUAL_FISCAL_PROVIDER_PRIORITY=gemini,custom,openai
VISUAL_FISCAL_PREFERRED_PROVIDER=gemini
VISUAL_FISCAL_GEMINI_API_KEY=
VISUAL_FISCAL_GEMINI_MODEL=gemini-3.7-flash
VISUAL_FISCAL_CUSTOM_ENDPOINT=
VISUAL_FISCAL_CUSTOM_API_KEY=
VISUAL_FISCAL_CUSTOM_MODEL=custom
VISUAL_FISCAL_CUSTOM_ALLOW_HTTP_LOCALHOST=false
VISUAL_FISCAL_OPENAI_API_KEY=
VISUAL_FISCAL_OPENAI_MODEL=gpt-4.1-mini
VISUAL_FISCAL_ALLOW_PAID_FALLBACK=false
VISUAL_FISCAL_TIMEOUT_MS=120000

# Construction AI Studio V4 — runtime local
# Copie para .env somente se precisar alterar host/porta de desenvolvimento.
# O fluxo operacional não usa Gemini, OpenAI API, Groq ou provider visual externo.

CONSTRUCTION_AI_HOST=127.0.0.1
CONSTRUCTION_AI_PORT=8787
VISUAL_DIAGNOSTICS=false

# A análise da Imagem Inicial é orquestrada pelo ChatGPT através do
# Construction AI Relay e fica vinculada ao SHA-256 da imagem.
# Credenciais de IA externa não pertencem mais ao runtime operacional.

# Construction AI Studio V4 — runtime local
# Copie para .env somente se precisar alterar host/porta de desenvolvimento.
# O fluxo operacional de análise visual é ChatGPT + Relay, sem provider visual HTTP externo.

CONSTRUCTION_AI_HOST=127.0.0.1
CONSTRUCTION_AI_PORT=8787

# A análise da Imagem Inicial fica vinculada ao SHA-256 da imagem e entra
# no Construction AI como revisão estruturada antes da criação do projeto.
# Credenciais de IA visual externa não pertencem ao runtime operacional.

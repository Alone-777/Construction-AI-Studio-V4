{
  "name": "construction-ai-studio",
  "version": "4.0.0",
  "type": "module",
  "description": "Construction AI Studio V4 — Motor Determinístico de Construção Audiovisual",
  "scripts": {
    "ligar": "node scripts/start-studio.mjs",
    "verificar": "node scripts/check-studio.mjs",
    "dev": "vite",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fiscal-agent": "vitest run server/visual-fiscal-agent tools/visual-fiscal-agent.test.mjs",
    "test:logistics": "vitest run src/core/actions/physical-execution-v2 src/core/engines/pipeline/stages/stages-executor.commit-integrity.test.ts tools/manual-v2-bridge.test.mjs tools/create-firefly-project.test.mjs tools/migrate-manual-workspace-to-physical-v2.test.mjs",
    "examples:logistics": "node tools/examples-logistics-shadow.mjs",
    "test:accept": "vitest run --reporter=verbose src/core/__tests__/acceptance",
    "instalar-atalho": "node scripts/install-launcher.mjs",
    "instalar-botao": "node scripts/install-launcher.mjs",
    "migrar-kling30": "node tools/migrate-video-provider-to-kling30.mjs"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "immer": "^10.1.1",
    "lucide-react": "^0.474.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.4"
  }
}
